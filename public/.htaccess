<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Bypass rewriting for the backend API folder
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule ^ - [L]

  # Bypass rewriting for actual existing files and directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Rewrite all other URLs to index.html for Single Page Application (SPA) routing
  RewriteRule . /index.html [L]
</IfModule>
